# Copy to .env (chmod 600). Never commit .env.

# MyFitnessPal username (not email). Needed because MFP's profile endpoint
# returns 500 for some accounts.
MFP_USERNAME=

# Only used by scripts/mfp_auth.py to connect a new session: the value of the
# __Secure-next-auth.session-token cookie from a private-window login.
# After connecting, the live session is kept (and renewed) in state/mfp/.
# Never passed into the containers; clear it once connected.
MFP_COOKIE=

# Telegram bot ----------------------------------------------------------------
# From @BotFather. Only one process may poll a token.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id; everyone else is ignored.
TELEGRAM_ALLOWED_USER_ID=
# Any Pydantic AI model string, e.g. anthropic:claude-sonnet-5-5 or
# openai:<model>. Set the API key for that provider.
BOT_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional custom endpoints. For any OpenAI-compatible server (OpenRouter,
# Ollama, LiteLLM, ...) use BOT_MODEL=openai:<model> plus OPENAI_BASE_URL,
# e.g. https://openrouter.ai/api/v1 or http://host:11434/v1.
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# Docker ----------------------------------------------------------------------
# Where the UI listens on the host. On the server: its Tailscale IP (100.x.y.z).
FA_BIND=127.0.0.1
FA_PORT=8000
TZ=Europe/Vienna

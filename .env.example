# Copy to .env (chmod 600). Never commit .env.

# MyFitnessPal username (not email). Needed because MFP's profile endpoint
# returns 500 for some accounts.
MFP_USERNAME=

# Only used by scripts/mfp_auth.py to connect a new session: the value of the
# __Secure-next-auth.session-token cookie from a private-window login.
# After connecting, the live session is kept (and renewed) in state/mfp/.
# Only the one-off auth container sees it (README); clear it once connected.
MFP_COOKIE=

# Telegram bot ----------------------------------------------------------------
# From @BotFather. Only one process may poll a token.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id; everyone else is ignored.
TELEGRAM_ALLOWED_USER_ID=
# Any Pydantic AI model string, e.g. anthropic:claude-sonnet-5-5 or
# openai:<model>. Set the API key for that provider.
BOT_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional custom endpoints. For any OpenAI-compatible server (OpenRouter,
# Ollama, LiteLLM, ...) use BOT_MODEL=openai:<model> plus OPENAI_BASE_URL,
# e.g. https://openrouter.ai/api/v1 or http://host:11434/v1.
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# Coach -----------------------------------------------------------------------
# A second bot from @BotFather, not the food bot's token. Only one process may
# poll it. The coach answers only TELEGRAM_ALLOWED_USER_ID (above).
COACH_TELEGRAM_BOT_TOKEN=
# Claude models: COACH_MODEL for chat and daily messages, the stronger
# COACH_DECISION_MODEL for the weekly decision.
COACH_MODEL=claude-sonnet-5-5
COACH_DECISION_MODEL=claude-opus-5-5
# Optional: the coach's own Anthropic(-compatible) endpoint and key. Empty =
# ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL above.
COACH_ANTHROPIC_API_KEY=
COACH_ANTHROPIC_BASE_URL=

# Docker ----------------------------------------------------------------------
# Where the UI listens on the host: 127.0.0.1, 0.0.0.0 (LAN), or a Tailscale IP.
FA_BIND=127.0.0.1
FA_PORT=8000
# MCP tools for Claude Code on the host; always bound to 127.0.0.1.
FA_TOOLS_PORT=8001
TZ=Europe/Vienna
# Image tag for all services. Leave unset in the main checkout; a second
# checkout or worktree sets its own (README, Development).
# FA_IMAGE=fitness-aggregator:latest

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "photo_review.schema.json",
  "title": "Photo review",
  "description": "Output of the photo-review skill at each photo check-in. The skill receives the new photo set, the previous photo set and the previous estimate, and judges relative change. The estimate is stored and appears as weekly_facts.measurements.latest_bf_estimate.",
  "type": "object",
  "required": ["schema_version", "date", "photo_set_id", "previous_photo_set_id", "comparability", "comparability_issues", "change_vs_previous", "bf_estimate", "confidence", "notes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "date": { "type": "string", "format": "date" },
    "photo_set_id": { "type": "string" },
    "previous_photo_set_id": { "type": ["string", "null"] },
    "comparability": { "enum": ["good", "limited", "poor", "no_previous"] },
    "comparability_issues": {
      "type": "array",
      "items": { "enum": ["lighting", "camera_height", "distance_or_angle", "pose", "pumped", "time_of_day", "clothing", "missing_view", "other"] }
    },
    "change_vs_previous": { "enum": ["leaner", "similar", "softer", "not_comparable"] },
    "bf_estimate": {
      "type": "object",
      "required": ["low_pct", "high_pct"],
      "additionalProperties": false,
      "properties": {
        "low_pct": { "type": "number", "minimum": 3, "maximum": 50 },
        "high_pct": { "type": "number", "minimum": 3, "maximum": 50 }
      }
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "notes": { "type": "string", "description": "2-4 sentences for the user: what changed, how reliable the comparison is, protocol fixes for next time." }
  }
}

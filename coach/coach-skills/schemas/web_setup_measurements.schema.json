{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web_setup_measurements.schema.json",
  "title": "Web: Setup, Measurements",
  "description": "GET /api/coach/setup/measurements. Waist values, photo sets and body-fat estimates, newest first, with the next due dates of the active phase. POST /api/coach/setup/measurements/waist {cm, date?} stores a waist value (chat's range check; date defaults to today, never in the future) and returns this view. Each photo is served read-only as an image at GET /api/coach/<url>.",
  "type": "object",
  "required": ["today", "waist", "photos", "body_fat"],
  "additionalProperties": false,
  "properties": {
    "today": { "type": "string", "format": "date" },
    "waist": {
      "type": "object",
      "required": ["start", "values", "next_due", "min", "max"],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": ["object", "null"],
          "description": "The waist from the active phase's setup, on its start date. null: no phase or not given.",
          "required": ["date", "cm"],
          "additionalProperties": false,
          "properties": { "date": { "type": "string", "format": "date" }, "cm": { "type": "number" } }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "cm"],
            "additionalProperties": false,
            "properties": { "date": { "type": "string", "format": "date" }, "cm": { "type": "number" } }
          }
        },
        "next_due": { "type": ["string", "null"], "format": "date", "description": "null: no active phase." },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "photos": {
      "type": "object",
      "required": ["enabled", "next_due", "sets"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": ["boolean", "null"], "description": "Photo check-ins on (null: no active phase). Photos sent anyway are kept." },
        "next_due": { "type": ["string", "null"], "format": "date" },
        "sets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "photos"],
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string", "format": "date" },
              "photos": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["number", "url", "caption", "received_at"],
                  "additionalProperties": false,
                  "properties": {
                    "number": { "type": "integer", "minimum": 1 },
                    "url": { "type": "string", "pattern": "^photos/[0-9]{4}-[0-9]{2}-[0-9]{2}/[1-9][0-9]*$", "description": "Relative to /api/coach/." },
                    "caption": { "type": ["string", "null"] },
                    "received_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "body_fat": {
      "type": "array",
      "description": "Body-fat estimates, one per date, newest first: the photo review's (source model) or the user's own (source user), which wins for its date. model_pct: the model's estimate the user's overrides (null otherwise). Read-only.",
      "items": {
        "type": "object",
        "required": ["date", "pct", "source", "model_pct"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "format": "date" },
          "pct": { "type": "number" },
          "source": { "enum": ["model", "user"] },
          "model_pct": { "type": ["number", "null"] }
        }
      }
    }
  }
}

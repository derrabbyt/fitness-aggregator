{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weekly_verdict.schema.json",
  "title": "Weekly verdict",
  "description": "Returned by the weekly-decision skill as structured output. Stored together with the weekly facts it was based on. If proposal is not null, code passes it to propose_change, which runs the guardrails.",
  "type": "object",
  "required": ["schema_version", "iso_week", "phase_id", "usable", "unusable_reasons", "scenario", "weight_assessment", "progression", "direction", "confirmation", "adherence_gate", "sport_load_applied", "proposal", "flags", "rules_applied", "confidence", "reasoning", "questions_for_user"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "iso_week": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "phase_id": { "type": "string" },

    "usable": { "type": "boolean" },
    "unusable_reasons": {
      "type": "array",
      "items": { "enum": ["too_few_weigh_ins", "incomplete_food_log", "stale_sync", "illness", "travel", "other_context"] }
    },

    "scenario": {
      "type": "string",
      "description": "A scenario id from the active phase's decision table (reverse_bulk: A, B, C, D, E), or one of the special values.",
      "pattern": "^([A-Z]|[a-z_]+|glycogen_window|unusable|adherence_gate)$"
    },
    "weight_assessment": {
      "enum": ["below_limit", "below_band", "in_band", "above_band", "above_limit", "not_evaluated"],
      "description": "Normally copied from weekly_facts.weight.vs_band; may only differ if a context note makes the trend misleading (explain in reasoning)."
    },
    "progression": { "enum": ["yes", "no", "not_evaluated"] },
    "direction": {
      "enum": ["increase", "decrease", "hold"],
      "description": "What this week's data points to for calories, regardless of whether a change is proposed. Used to count consecutive weeks."
    },
    "confirmation": {
      "type": "object",
      "required": ["consecutive_usable_weeks_same_direction", "required_weeks", "met"],
      "additionalProperties": false,
      "properties": {
        "consecutive_usable_weeks_same_direction": { "type": "integer", "minimum": 0, "description": "Including this week. Unusable weeks are skipped, not counted, and do not break the streak. Weeks before the last applied change do not count." },
        "required_weeks": { "type": "integer", "minimum": 1 },
        "met": { "type": "boolean" }
      }
    },
    "adherence_gate": { "enum": ["pass", "fail", "not_applicable"] },
    "sport_load_applied": { "type": "boolean", "description": "True if a high sport-load week suppressed a C or D style proposal." },

    "proposal": {
      "description": "Calorie change to propose, or null. Only when the phase table calls for a change, the week is usable, the adherence gate passes and confirmation is met.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["type", "delta_kcal", "size", "reason", "is_phase_first_change"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "calorie_change" },
            "delta_kcal": { "type": "number", "description": "Signed change to surplus_kcal (daily average)." },
            "size": { "enum": ["small", "large", "phase_start"] },
            "reason": { "type": "string" },
            "is_phase_first_change": { "type": "boolean" },
            "returning_rejected_proposal_id": { "type": ["string", "null"] }
          }
        }
      ]
    },

    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "detail"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "glycogen_jump", "weight_watch_zone", "trend_reversal", "weight_spike", "prediction_miss",
              "adherence_fail", "intake_overshoot", "intake_undershoot", "intake_pattern", "macro_off", "fiber_off", "produce_low", "odd_log",
              "lift_stall", "deload_signal", "training_needs_look", "missed_session_pattern", "sport_load_week",
              "step_floor",
              "bodyfat_near_ceiling", "photo_fat_concern", "time_goal_near",
              "rejected_proposal_returning", "data_stale", "other"
            ]
          },
          "severity": { "enum": ["info", "watch", "action"] },
          "detail": { "type": "string" },
          "exercise_id": { "type": ["string", "null"] }
        }
      }
    },
    "rules_applied": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]+-[A-Z0-9-]+$" },
      "description": "Rule ids from the skills (e.g. WD-ADHERENCE, RB-E) so decisions can be audited and replay-tested."
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "reasoning": { "type": "string", "description": "2-5 sentences. Plain language. Used by the weekly-report skill; not sent verbatim." },
    "questions_for_user": { "type": "array", "items": { "type": "string" }, "maxItems": 2 }
  }
}
